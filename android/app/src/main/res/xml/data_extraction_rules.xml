<?xml version="1.0" encoding="utf-8"?>
<!-- Перенос на устройство разрешён, облако — нет. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
